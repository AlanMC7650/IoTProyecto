# Base de datos. Con Supabase: Connect -> Session pooler (funciona en redes IPv4)
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_USER=postgres.<id-del-proyecto>
#   DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=iot
# true para cifrar la conexión con la BD (recomendado con Supabase)
DB_SSL=false
JWT_SECRET=una_clave_secreta_larga_random
PORT=3000
# true para ver cada query SQL en la consola (por defecto solo errores)
DB_LOGGING=false

# Solo para `npm run simular`: clave pública del proyecto de Supabase
# (Project Settings -> API Keys -> anon / publishable). La misma que va en ESP32/config.py.
SUPABASE_ANON_KEY=
# Opcional: si falta se arma con el id del proyecto que está en DB_USER
SUPABASE_URL=
