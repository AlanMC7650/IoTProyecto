# Variables para docker compose (copiar a .env en la raíz del repo).
# Todas tienen un valor por defecto; cambiá al menos JWT_SECRET y DB_PASSWORD.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=iot
JWT_SECRET=una_clave_secreta_larga_random
DB_LOGGING=false

# Puertos publicados en la PC
BACK_PORT=3000
DB_PUBLIC_PORT=5433
ESP32_API_PORT=8000
